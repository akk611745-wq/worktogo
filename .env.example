# ============================================================================
#  WorkToGo — Environment Template  (copy to `.env`, fill in real values)
# ----------------------------------------------------------------------------
#  Turnkey staging/prod setup. NEVER commit the real .env (only this template).
#  Values here are safe placeholders. Lines the launch needs are marked REQUIRED.
#  The app loads this via app/index.php + config/*; getenv() reads each key.
# ============================================================================

# ── App ─────────────────────────────────────────────────────────────────────
# REQUIRED. APP_URL is the API/base origin. Leave BLANK for same-origin (the
# safe default — staging talks to staging, prod to prod). Set it ONLY to point
# the browser app at a different API host. Never point staging at the prod URL.
APP_URL=
APP_ENV=staging                 # staging | production  (production = OTP fails loud, no dev echo)
APP_DEBUG=false                 # true ONLY in local dev (enables OTP debug echo)
APP_TIMEZONE=Asia/Kolkata

# ── Database (MySQL/MariaDB) ─────────────────────────────────────────────────
# REQUIRED. Back up before running `php migrate.php`.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=worktogo
DB_USER=worktogo
DB_PASS=change-me
DB_TIMEZONE=+05:30

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# REQUIRED. Long random secrets (32+ bytes). Rotating them logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=2592000              # default token lifetime (s). Admin tokens are 12h in code.
JWT_REFRESH_EXP=2592000
AGENT_CONFIRM_SECRET=change-me-another-long-random-string   # signs agent write-confirm tokens

# ── Payment — Razorpay (recommended PRIMARY) ─────────────────────────────────
# Get from the Razorpay dashboard. Use TEST keys on staging, LIVE on prod.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENV=test               # test | live
RAZORPAY_WEBHOOK_SECRET=

# ── Payment — Cashfree (SECONDARY / failover; already integrated) ────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX            # SANDBOX | PRODUCTION

# ── AI Agent (Anthropic) ─────────────────────────────────────────────────────
# REQUIRED to run the agent with real understanding. Spend is capped at $20/mo
# in code (auto-pause). Confirm zero-retention terms before pointing at prod data.
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AGENT_ANTHROPIC_MAXTOK=1024

# ── SMS OTP — MSG91 (PRIMARY) ────────────────────────────────────────────────
# REQUIRED for phone-OTP login. Transactional template must be approved.
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=WRKGO
# Optional MSG91 widget (client-side OTP widget flow):
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN_AUTH=

# ── SMS OTP — SECONDARY provider (failover target) ───────────────────────────
# Wire ONE of these + set the app_settings auth_channel_routing secondary so the
# smart-auth layer can divert when MSG91 is down. Until then there is no real
# OTP failover. (Also legacy fallbacks: Fast2SMS / Twilio.)
FAST2SMS_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# WhatsApp OTP channel (optional 2nd channel):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=

# ── OTP / rate-limit tuning (safe defaults in code; override only if needed) ─
OTP_METHOD=sms
OTP_SEND_IP_MAX=20
OTP_SEND_IP_WINDOW=600
OTP_VERIFY_IP_MAX=30
OTP_VERIFY_IP_WINDOW=600
BOOKING_RATE_MAX=20
BOOKING_RATE_WINDOW=600
AUTH_METHODS_IP_MAX=60
AUTH_METHODS_IP_WINDOW=600

# ── Google (Maps + Sign-In) ──────────────────────────────────────────────────
# Maps: address autocomplete/geocode (now loaded on demand). Without it, address
# entry degrades to plain text. Sign-In: Google login (optional at launch).
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=              # optional comma-separated list (multiple OAuth clients)

# ── Firebase Cloud Messaging (push) — OFF at launch ──────────────────────────
# Leave BLANK to skip: the app ships NO Firebase SDK unless FCM_API_KEY +
# FCM_VAPID_KEY are set. Fill these only when enabling notifications.
FCM_API_KEY=
FCM_PROJECT_ID=
FCM_SENDER_ID=
FCM_APP_ID=
FCM_VAPID_KEY=
FCM_SERVICE_ACCOUNT_PATH=      # path to the FCM service-account JSON (server push)

# ── Engines registry (leave blank = local folder; a URL = remote microservice)─
ENGINE_SERVICE_URL=            # blank → body/service-engine (local)
ENGINE_SHOPPING_URL=           # blank → local; commerce is hidden at launch
ENGINE_DELIVERY_URL=           # blank → dormant at launch
ENGINE_VIDEO_URL=              # blank → dormant

# ── Heart / internal / logging ───────────────────────────────────────────────
HEART_INTERNAL_KEY=change-me   # guards internal engine-to-engine calls
HEART_LOG_LEVEL=warning        # debug | info | warning | error
LOG_LEVEL=warning
ADMIN_KEY=                     # optional: gates the Heart debug mode (X-Admin-Key header)

# ── Brain (personalization) — OFF at launch; leave blank ─────────────────────
BRAIN_API_URL=
BRAIN_API_KEY=
BRAIN_CLIENT_ID=
BRAIN_CIRCUIT_THRESHOLD=5
BRAIN_CIRCUIT_WINDOW=60
